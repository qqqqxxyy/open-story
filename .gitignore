.venv/
venv/
env/

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Runtime and generated story data
open-story-data/
backups/
.pending.json
.runtime.lock
*.tmp
*.tmp-*
*.log

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Local story stores and per-story runtime configuration
/story-data/

# Local legacy archive
/v5_old/

